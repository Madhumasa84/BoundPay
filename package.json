{
  "name": "boundpay",
  "version": "0.1.0",
  "private": true,
  "description": "BoundPay - Inspectable bounded financial authority for agentic commerce",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run test/unit",
    "test:property": "vitest run test/property",
    "test:integration": "vitest run test/integration",
    "test:deterministic": "vitest run test/evaluation/deterministic-manifest.test.ts",
    "test:state": "vitest run test/property/state-machine-sequences.prop.test.ts",
    "eval:manifest": "tsx evaluation/generate-manifest.ts",
    "eval:latency": "tsx evaluation/benchmark-policy.ts",
    "eval:live": "tsx evaluation/run-live-model-evaluation.ts",
    "test:e2e": "CONFIRM_RESET=true tsx src/infrastructure/db/reset.ts && playwright test",
    "db:migrate": "tsx src/infrastructure/db/migrate.ts",
    "db:seed": "tsx src/infrastructure/db/seed.ts",
    "db:reset": "tsx src/infrastructure/db/reset.ts"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ],
    "overrides": {
      "postcss": ">=8.5.23",
      "sharp": ">=0.35.0"
    }
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^11.8.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.39.0",
    "next": "15.5.21",
    "openai": "^7.9.0",
    "razorpay": "^2.9.8",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/bcryptjs": "^3.0.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.4.1",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "autoprefixer": "^10.5.4",
    "drizzle-kit": "^0.31.10",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.24",
    "fast-check": "^4.9.0",
    "postcss": "^8.5.26",
    "tailwindcss": "3.4.14",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
