# BoundPay Phase 1 Environment Configuration
# Copy this file to .env.local or .env for local development

NODE_ENV=development
PORT=3000

# SQLite Database path
DATABASE_PATH=./data/boundpay.sqlite

# Session secret for cookie encryption/signing (at least 32 characters)
SESSION_SECRET=placeholder_replace_with_at_least_32_chars_random_secret

# Initial operator credentials for database seed
OPERATOR_USERNAME=operator
OPERATOR_INITIAL_PASSWORD=ChangeMe123!

# Default Merchant ID
DEFAULT_MERCHANT_ID=demo_store

# Payment Adapter Mode (MOCK for Phase 1)
PAYMENT_ADAPTER_MODE=MOCK

# Quote validity duration in seconds (default: 600 = 10 minutes)
QUOTE_VALIDITY_SECONDS=600
