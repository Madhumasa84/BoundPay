# BoundPay Environment Configuration (Phase 4 Authority Passport build)
# Copy this file to .env.local or .env for local development

NODE_ENV=development
PORT=3000

# SQLite Database path (WAL mode enabled)
DATABASE_PATH=./data/boundpay.sqlite

# Session secret for cookie encryption/signing (at least 32 characters)
SESSION_SECRET=placeholder_replace_with_at_least_32_chars_random_secret

# Initial operator credentials for database seed
OPERATOR_USERNAME=operator
OPERATOR_INITIAL_PASSWORD=BoundPayPass123!

# Default Merchant ID
DEFAULT_MERCHANT_ID=demo_store

# Payment Adapter Mode ('MOCK' or 'RAZORPAY_TEST')
# Note: Existing intents preserve their creation mode. Strictly rejects 'rzp_live_' keys!
PAYMENT_ADAPTER_MODE=MOCK

# Razorpay TEST Credentials (required when PAYMENT_ADAPTER_MODE=RAZORPAY_TEST)
# MUST start with 'rzp_test_'. Live keys ('rzp_live_...') are strictly rejected.
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=placeholder_key_secret
RAZORPAY_WEBHOOK_SECRET=placeholder_webhook_secret

# Shopping Agent Model Integration ('fixture' or 'live')
# 'fixture': Deterministic offline keyword/catalog matcher (no API key needed)
# 'live': Calls live AI model with strict JSON Schema structured output (never silently falls back)
AGENT_MODE=fixture
AI_PROVIDER=sarvam

# Sarvam AI Configuration (default live model provider)
# Endpoint: https://api.sarvam.ai/v1/chat/completions with api-subscription-key header
# Note: sarvam-105b is required; sarvam-30b is deprecated.
SARVAM_API_KEY=
SARVAM_MODEL=sarvam-105b

# Optional OpenAI Configuration (only used if AI_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Quote validity duration in seconds (default: 600 = 10 minutes)
QUOTE_VALIDITY_SECONDS=600

# Authority Passport Ed25519 signing (server-only; never use NEXT_PUBLIC_*).
# Generate file-backed keys with: pnpm run authority:keys
# File paths are preferred so private material is never printed in shell output.
AUTHORITY_SIGNING_PRIVATE_KEY_FILE=.authority/authority-private.pem
AUTHORITY_SIGNING_PUBLIC_KEY_FILE=.authority/authority-public.pem
AUTHORITY_SIGNING_KEY_ID=authority-key-v1
AUTHORITY_ISSUER=boundpay-authority
AUTHORITY_AUDIENCE=boundpay-agent
# Optional JSON map for public-key rotation: {"old-kid":"-----BEGIN PUBLIC KEY-----\\n..."}
AUTHORITY_VERIFICATION_KEYS_JSON=
# Test-only flag. Never enable in production; Playwright sets it automatically.
AUTHORITY_TEST_MODE=false

# Optional shared spending allowance backed by Drunix. Keep disabled unless the
# chaincode is deployed to the named channel and all identities match its MSP.
# SIMULATED is label-only and fails closed; it never authorizes provider calls.
SHARED_AUTHORITY_MODE=DISABLED
DRUNIX_MANDATE_ID=boundpay-mandate-demo-v1
DRUNIX_CHANNEL=boundpay
DRUNIX_CHAINCODE=boundpay-shared-authority
# Set these separately for each independently operated service instance.
DRUNIX_MSP_ID=Org1MSP
DRUNIX_VERIFIER_MSP_ID=Org1MSP
DRUNIX_GATEWAY_ENDPOINT=localhost:7051
DRUNIX_PEER_HOST_ALIAS=peer0.org1.example.com
# Replace each clientId with the exact result from GetCallerIdentity for the
# separately configured participant certificates. MSP membership alone does
# not grant this mandate spending authority.
DRUNIX_PARTICIPANT_IDENTITIES_JSON='[{"mspId":"Org1MSP","clientId":"REPLACE_WITH_ORG1_GETCALLERIDENTITY_CLIENT_ID"},{"mspId":"Org2MSP","clientId":"REPLACE_WITH_ORG2_GETCALLERIDENTITY_CLIENT_ID"}]'
# Replace with the exact clientId returned by GetCallerIdentity for the verifier.
DRUNIX_VERIFIER_IDENTITIES_JSON='[{"mspId":"Org1MSP","clientId":"REPLACE_WITH_EXACT_GETCALLERIDENTITY_CLIENT_ID"}]'
DRUNIX_TLS_ROOT_CERT_FILE=/path/to/peer0-org1-tls-ca.pem
DRUNIX_CLIENT_CERT_FILE=/path/to/participant-signcert.pem
DRUNIX_CLIENT_PRIVATE_KEY_FILE=/path/to/participant-private-key.pem
DRUNIX_VERIFIER_CLIENT_CERT_FILE=/path/to/verifier-signcert.pem
DRUNIX_VERIFIER_CLIENT_PRIVATE_KEY_FILE=/path/to/verifier-private-key.pem
DRUNIX_COMMIT_TIMEOUT_MS=60000
# Generate an independent random 32-byte key for each service; store it outside
# source control. This encrypts local commitment salts using AES-256-GCM.
SHARED_AUTHORITY_LOCAL_ENCRYPTION_KEY=REPLACE_WITH_BASE64_OF_32_RANDOM_BYTES
